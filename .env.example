# ELYAN for Professionals — Phase A environment template
# Copy to .env locally. Set the same keys in Vercel Project → Settings → Environment Variables.
# NEVER commit real secrets.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=

# Supabase anon/public key (safe for browser via /api/professionals/public-config)
SUPABASE_ANON_KEY=

# Supabase service role key (SERVER ONLY — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin for Professionals links in emails (e.g. https://www.elyan.be)
# Must match the public production origin used in Supabase Auth redirect allowlist.
PROFESSIONALS_APP_URL=

# Existing Resend API key for invite delivery (SERVER ONLY)
RESEND_API_KEY=

# Vercel Blob token — Phase B portfolio uploads (SERVER ONLY; never expose to browser)
BLOB_READ_WRITE_TOKEN=

# Auth notes (no secrets):
# - Invite password links: /professionals/set-password/<elyan_token> → POST setup-password
# - Forgot password redirectTo: {PROFESSIONALS_APP_URL}/professionals/reset-password
# - See docs/AUTH_PROFESSIONALS.md for Supabase Site URL / redirect allowlist
