{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/internal/:path*",
      "destination": "/404",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/public/v1/:path*",
      "destination": "/api/public/v1?path=:path*"
    },
    {
      "source": "/professionals/set-password/:payload",
      "destination": "/professionals/reset-password"
    },
    {
      "source": "/professionals/onboarding/:step",
      "destination": "/professionals/onboarding"
    },
    {
      "source": "/professionals/aanvragen/:requestId",
      "destination": "/professionals/aanvragen"
    },
    {
      "source": "/professionals/klanten/:customerKey",
      "destination": "/professionals/klanten"
    },
    {
      "source": "/professionals/control/:partnerId",
      "destination": "/professionals/control"
    },
    {
      "source": "/vakmannen/:category(dakwerken|badkamer|keuken|ramen-deuren|isolatie|verwarming|elektriciteit|gevel|vloeren|schilderwerken|ventilatie|zonnepanelen)/:regio",
      "destination": "/vakmannen"
    },
    {
      "source": "/vakmannen/:category(dakwerken|badkamer|keuken|ramen-deuren|isolatie|verwarming|elektriciteit|gevel|vloeren|schilderwerken|ventilatie|zonnepanelen)",
      "destination": "/vakmannen"
    },
    {
      "source": "/vakmannen/p/:slug/aanvraag",
      "destination": "/vakmannen-aanvraag"
    },
    {
      "source": "/vakmannen/:slug",
      "destination": "/vakmannen-detail"
    }
  ]
}
